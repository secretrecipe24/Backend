{
  "info": {
    "_postman_id": "4f7c0c7a-5d0a-4c8a-bb13-1c5bd5bba2e5",
    "name": "Wellness API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Get Subscription Plans",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/subscriptions/plans",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "subscriptions", "plans" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('success envelope present', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('success');",
                  "  pm.expect(json).to.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User (Client)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\",\n  \"age\": 25,\n  \"gender\": \"male\",\n  \"fitness_goals\": [\"weight_loss\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/register",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "user", "register" ]
            }
          }
        },
        {
          "name": "Login (sets user_token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/login",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "user", "login" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('login success', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "});",
                  "const token = json?.data?.token;",
                  "if (token) pm.environment.set('user_token', token);",
                  "const userId = json?.data?.user?.id;",
                  "if (userId) pm.environment.set('user_id', String(userId));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
